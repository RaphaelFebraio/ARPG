# ========================================
# LOCAL-FIRST (tudo roda na sua máquina)
# ========================================

# Banco (Docker)
DATABASE_URL=postgresql://grimoire:grimoire@localhost:5432/grimoire

# Redis (Docker, para BullMQ)
REDIS_URL=redis://localhost:6379

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Whisper (local)
WHISPER_CPP_PATH=./bin/whisper-cpp
WHISPER_MODEL_PATH=./models/ggml-base.bin
WHISPER_LANGUAGE=pt

# Armazenamento local
AUDIO_STORAGE_PATH=./data/audio
PDF_STORAGE_PATH=./data/pdf

# Auth
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
RAG_SIMILARITY_THRESHOLD=0.72
RAG_MAX_CHUNKS=5

# ========================================
# CLOUD FALLBACK (opcional, preencher se quiser)
# ========================================
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
